# Copia este archivo como .env (en la misma carpeta) y rellena los valores.
# .env esta en .gitignore: NUNCA se sube al repo.

# ── Notificaciones ──────────────────────────────────────────────────────
# ntfy (por defecto) | telegram
NOTIFICADOR=ntfy
# Tema privado de ntfy: largo y aleatorio (funciona como contrasena).
# Generalo con:  python -c "import secrets;print('modus-'+secrets.token_urlsafe(24))"
NTFY_TEMA=
NTFY_SERVIDOR=https://ntfy.sh
# Alternativa: bot de Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets ───────────────────────────────────────────────────────
# Ruta al JSON de la cuenta de servicio, FUERA de la carpeta del repo
GOOGLE_CREDENCIALES=C:\Users\TU_USUARIO\claves\modus-cuenta-servicio.json
# Por defecto, el Sheet de predicciones (SHEET_ID_PREDICCIONES de config.py)
SHEET_ID=

# ── App y avisos ────────────────────────────────────────────────────────
# Al tocar el aviso se abre la app con el partido elegido
APP_URL=https://modusapp.streamlit.app
TOPE_DIARIO=50
# Cada cuanto se recargan los datos del Sheet (segundos)
RECARGA_DATOS_SEG=300
# Duracion media de un partido: no tienen hora fija, empiezan seguidos
DURACION_PARTIDO_MIN=10
# Se avisa de cada partido cuando faltan como mucho estos minutos
AVISO_MIN_ANTES=45
