# Copia este archivo como .env (en la misma carpeta) y rellena los valores.
# .env esta en .gitignore: NUNCA se sube al repo.

# ── Notificaciones ──────────────────────────────────────────────────────
# ntfy (por defecto) | telegram
NOTIFICADOR=ntfy
# Tema privado de ntfy: largo y aleatorio. Quien lo sepa puede leer tus
# avisos. Genera uno con:  python -c "import secrets;print('modus-'+secrets.token_urlsafe(24))"
NTFY_TEMA=
NTFY_SERVIDOR=https://ntfy.sh
# Alternativa: bot de Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets ───────────────────────────────────────────────────────
# Ruta al JSON de la cuenta de servicio (la misma que usa la app). Guardalo
# FUERA de la carpeta del repo.
GOOGLE_CREDENCIALES=C:\Users\TU_USUARIO\claves\modus-cuenta-servicio.json
# Por defecto se usa el Sheet de predicciones (SHEET_ID_PREDICCIONES de config.py)
SHEET_ID=

# ── Reglas ──────────────────────────────────────────────────────────────
# Palabras que identifican el torneo en Winamax (separadas por comas).
# Confirmalo el primer dia con: python -m vigia --dump
WINAMAX_TORNEO=modus
TOPE_DIARIO=50
# Cada cuanto se recargan los datos del Sheet (segundos)
RECARGA_DATOS_SEG=300
# Solo se miran los mercados de partidos que empiezan en menos de estos minutos
VENTANA_MIN=120
